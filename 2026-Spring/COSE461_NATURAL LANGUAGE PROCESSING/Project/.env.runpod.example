# Copy to .env.runpod and fill your values.

# RunPod SSH tunnel variables
# Use either RUNPOD_SSH_HOST (IP/domain) or RUNPOD_POD_ID.
RUNPOD_SSH_HOST=38.147.83.26
RUNPOD_POD_ID=abc123def456
RUNPOD_SSH_PORT=46442
RUNPOD_SSH_KEY=/home/your_user/.ssh/id_ed25519

# Optional: direct TCP endpoint (when RunPod TCP mapping is enabled)
# RUNPOD_GRPC_HOST=abc123def456-50051.proxy.runpod.net
# RUNPOD_GRPC_PORT=15432

# Optional: public pod IP endpoint (if firewall/NAT allows it)
# RUNPOD_GRPC_HOST=38.147.83.26
# RUNPOD_GRPC_PORT=50051
