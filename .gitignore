# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Byte-compiled files with suffixes from temp editors
*.pyc.*

# Timestamped pytest logs (keep latest.log and named logs)
logs/pytest_*.log

# Dataset images (too large for git — only JSON annotations are tracked)
dataset/cvat_upload/
dataset/annotated/*.png
dataset/cvat_urls.txt
dataset/cvat_urls_local.txt

# Evaluation output images
eval_outputs/

# Model checkpoints (too large for git)
ckpt/

# Large dataset image directories
dataset/images/
dataset/vla-evaluation/
dataset/vla-evaluation-v3/
dataset/vla-evaluation-v4/
dataset/finetune/
dataset/finetune_v2/
dataset/finetune_preview/
dataset/ambres/
dataset/ambres-training/
